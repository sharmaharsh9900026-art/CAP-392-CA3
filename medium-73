class Solution {
    public void setZeroes(int[][] matrix) {
        ArrayList<Integer> rows = new ArrayList<>();
        ArrayList<Integer> cols = new ArrayList<>();

        int m = matrix.length;
        int n = matrix[0].length;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (matrix[i][j] == 0) {
                    rows.add(i);
                    cols.add(j);
                }
            }
        }

        for (int i = 0; i < rows.size(); i++) {
            int r = rows.get(i);

            for (int j = 0; j < n; j++) {
                matrix[r][j] = 0;
            }
        }

        for (int i = 0; i < cols.size(); i++) {
            int c = cols.get(i);

            for (int j = 0; j < m; j++) {
                matrix[j][c] = 0;
            }
        }
    }
}
